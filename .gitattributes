# Render images are stored with Git LFS (served from the
# factorio-blueprints-lfs R2 bucket, see .lfsconfig). Only image files inside
# a directory named exactly "renders", at any depth, and wiki images (below)
# are tracked. Everything else, including blueprint.json, markdown and blog
# images, stays in plain git.
**/renders/**/*.jpg filter=lfs diff=lfs merge=lfs -text
**/renders/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
**/renders/**/*.png filter=lfs diff=lfs merge=lfs -text
**/renders/**/*.webp filter=lfs diff=lfs merge=lfs -text

# Wiki images are stored with Git LFS too: image files inside a folder named
# "_attachments" (where Obsidian pastes them, see .obsidian/app.json) under
# wiki/, at any depth. CI publishes compressed copies (_tools/ci/build-wiki.ts).
wiki/**/_attachments/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
wiki/**/_attachments/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
wiki/**/_attachments/**/*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
wiki/**/_attachments/**/*.[wW][eE][bB][pP] filter=lfs diff=lfs merge=lfs -text
wiki/**/_attachments/**/*.[gG][iI][fF] filter=lfs diff=lfs merge=lfs -text

# Text files are stored with LF line endings on every OS, as the conventions
# require, so Windows checkouts do not rewrite blueprint.json or notes.
*.json text eol=lf
*.md text eol=lf

# Shell scripts must keep LF endings or bash on Windows cannot run them.
*.sh text eol=lf
